# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Gradle writes reports here; the root `/build/` pattern is anchored and misses it.
/android/build/

# Signing and Play credentials live outside the repository (HS_SECRETS_DIR).
# test/guards/signing_guard_test.dart asserts git ignores each shape below.
*.keystore
*.jks
*.p12
key.properties
*credentials*.txt
*-ci.json

# FVM, if a contributor uses it; the pin itself is .fvmrc and is tracked.
.fvm/
